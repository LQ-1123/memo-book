# ===== personal-library 配置模板：复制为 .env 后填写 =====

# --- 认证（必填）：逗号分隔，每台设备/调用方一个 key ---
API_KEYS=change-me-to-a-long-random-string

# --- 监听目录（核心入库通道）：逗号分隔多个目录 ---
# 例：WATCH_DIRS=/Users/sunyulin/Documents/notes,/Users/sunyulin/Library/clips
WATCH_DIRS=

# --- Qdrant（docker compose up -d 即可）---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=library

# --- 智谱开放平台（必填才能向量检索与问答）---
EMBED_API_KEY=
EMBED_MODEL=embedding-3
EMBED_DIM=2048
LLM_API_KEY=
LLM_MODEL=glm-4.6

# --- Rerank（可选：不填则跳过重排，检索仍可用）---
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 服务 ---
APP_HOST=0.0.0.0
APP_PORT=8787

# --- OCR（扫描版 PDF；rapidocr 未安装或设 false 时跳过）---
OCR_ENABLED=true

# --- URL 抓取 SSRF 防护（默认拒绝内网/环回地址；个人内网工具确需抓内网页面时改 true）---
INGEST_ALLOW_PRIVATE_URLS=false

# --- 向量库形态 ---
# 服务器形态默认连 Docker Qdrant（QDRANT_URL）；桌面版用内嵌本地模式（向量存 data/qdrant/）
# 内嵌模式：QDRANT_EMBEDDED=true（无需 Docker，桌面版默认开启）
QDRANT_EMBEDDED=false
